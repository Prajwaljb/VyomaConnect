// Vyoma's desktop window, in the phone app's language (oneui-design skill) with the care of a Mac app:
// - The canvas is the PC's wallpaper, soft, with its accent; the light comes from its bright side,
//   so glass edges are lit facing it (and opposite, at 80%) and shadows fall away from it.
// - Every page has the phone's hero: the glyph, the big title, a line under it. Scrolled past, the
//   title rides in a glass bubble at the top, as the phone's header.
// - Things move like the phone: pages rise in, pressed things dip, the switch knob stretches while
//   held, rings and bars ease to new values, dialogs settle in, the status bubble drops from the top.
// - The sidebar is the phone's tab bar on its side: floating glass, the chosen item on a neutral
//   capsule with colour only in its icon and name. Up/Down move through it, Escape closes.

import { Palette, ScrollView } from "std-widgets.slint";
import "fonts/inter.ttf";

// One thing a phone may do here, and whether it may.
export struct Permission {
    key: string,
    name: string,
    detail: string,
    on: bool,
}

// One SIM's signal: [level] 0..4, [network] "5G".
export struct Sim {
    label: string,
    network: string,
    level: int,
}

export struct Phone {
    id: string,
    name: string,
    paired: bool,
    linked: bool,
    // The pairing code while one's on screen, and whether the phone asked (ours to accept).
    code: string,
    asking: bool,
    // "wifi", "cable", "bluetooth", or "" when away.
    via: string,
    // -1 when unknown.
    battery: int,
    charging: bool,
    can-ring: bool,
    can-browse: bool,
    can-share: bool,
    sims: [Sim],
    // Background clipboard sync: "on", "ask" (plugged in, waiting for Allow) or "plug".
    clip: string,
    // What it may do on this PC (paired phones only).
    permits: [Permission],
}

// A command phones can run here. [fingerprint]: Vyoma on the phone asks for it first.
export struct Command {
    key: string,
    name: string,
    command: string,
    fingerprint: bool,
}

// A feature that needs something on the PC; [detail]: "Ready" or what it needs.
export struct Feature {
    name: string,
    ready: bool,
    detail: string,
}

// Something no package fixes. [state]: "ok", "info" (worth knowing) or "warn" (in the way).
export struct Check {
    name: string,
    state: string,
    detail: string,
}

// Something a phone did here: [meta] is "Phone · 14:32".
export struct Happening {
    kind: string,
    text: string,
    meta: string,
}

// One day of the activity, newest first.
export struct Day {
    label: string,
    items: [Happening],
}

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // The accent, from the PC's wallpaper as on the phone (set by the window); a blue until then.
    in-out property <color> accent-light: #2F6FDE;
    in-out property <color> accent-dark: #7DB0FF;
    // Filled accent controls: a deep shade under white ink in both themes (the phone's Glass.accent).
    in-out property <color> fill-light: #2563D9;
    in-out property <color> fill-dark: #2E6BE0;
    // The canvas: the wallpaper's colour grid, already toned for each theme.
    in-out property <image> wall-light;
    in-out property <image> wall-dark;
    in-out property <bool> has-wall;
    // Where the light comes from, clockwise from 3 o'clock (270deg is straight up): above the
    // wallpaper's brightest part, as on the phone (SpecularLight / lightAngle).
    in-out property <angle> light: 270deg;

    out property <angle> rim-angle: light - 90deg;
    out property <float> fall-x: -cos(light);
    out property <float> fall-y: -sin(light);
    out property <color> accent: dark ? accent-dark : accent-light;
    out property <color> accent-fill: dark ? fill-dark : fill-light;
    out property <image> wall: dark ? wall-dark : wall-light;
    out property <color> canvas: dark ? #000000 : #EDEEF2;
    out property <color> text: dark ? #F7F8FA : #0B0C0E;
    out property <color> muted: dark ? #AEB3BB : #50565F;
    // Glass (the phone's GlassDepth): a clear sheet, its edge lit facing the light.
    out property <color> card: dark ? #FFFFFF0C : #FFFFFF54;
    out property <color> rim-lit: dark ? #FFFFFF6B : #FFFFFF;
    out property <color> rim-base: dark ? #FFFFFF10 : #1A2B4C12;
    out property <brush> rim: @linear-gradient(rim-angle, rim-lit 0%, rim-base 30%, rim-base 70%, rim-lit.transparentize(20%) 100%);
    // Floating chrome (sidebar, title bubble, capsules): a little more body than cards.
    out property <color> chrome: dark ? #1C1D2194 : #FFFFFF8A;
    // Dialogs and the status bubble sit over anything, so they're nearly solid.
    out property <color> popup: dark ? #1C1D21F2 : #F7F8FAF5;
    out property <color> raised: dark ? #FFFFFF12 : #0000000A;
    out property <color> divider: dark ? #FFFFFF14 : #00000012;
    // The chosen item: a neutral capsule (light 12% black, dark 14% white), as the tab bar's.
    out property <color> selection: dark ? #FFFFFF24 : #0000001F;
    out property <color> hover: dark ? #FFFFFF10 : #0000000B;
    out property <color> pressed: dark ? #FFFFFF1A : #00000014;
    out property <color> track: dark ? #FFFFFF2E : #00000021;
    out property <color> shadow: dark ? #00000000 : #1A2B4C14;
    out property <color> connected: dark ? #4ADE80 : #16A34A;
    out property <color> pending: dark ? #FBBF24 : #D97706;
    out property <color> offline: dark ? #6B7280 : #9CA3AF;
    out property <color> error: dark ? #FF7A6E : #D93025;
    // Feature colours (iOS system palette); tiles take deeper tones so white words read.
    out property <color> blue: dark ? #0A84FF : #007AFF;
    out property <color> green: dark ? #30D158 : #34C759;
    out property <color> orange: dark ? #FF9F0A : #FF9500;
    out property <color> teal: dark ? #40C8E0 : #30B0C7;
    out property <color> red: dark ? #FF453A : #FF3B30;
    out property <color> gray: dark ? #8E8E93 : #8E8E93;
    out property <color> tile-blue: #0A62D2;
    out property <color> tile-teal: #148A99;
    out property <color> tile-orange: #C2700A;
}

export global Words {
    // One line under a phone's name in the sidebar.
    public pure function short(p: Phone) -> string {
        if p.code != "" { return p.asking ? "Wants to pair" : "Pairing…"; }
        if !p.paired { return "Not paired"; }
        if !p.linked { return "Away"; }
        if p.via == "wifi" { return "Wi-Fi"; }
        if p.via == "cable" { return "USB cable"; }
        if p.via == "bluetooth" { return "Bluetooth"; }
        return "Connected";
    }

    // The page's subtitle: how it's connected, in words.
    public pure function headline(p: Phone) -> string {
        if p.code != "" { return p.asking ? "Wants to pair with this PC" : "Waiting for the phone to accept"; }
        if !p.paired { return p.linked ? "Nearby, not paired" : "Not paired"; }
        if !p.linked { return "Away"; }
        if p.via == "wifi" { return "Connected via Wi-Fi"; }
        if p.via == "cable" { return "Connected by USB cable"; }
        if p.via == "bluetooth" { return "Connected over Bluetooth"; }
        return "Connected";
    }

    public pure function dot(p: Phone) -> color {
        if p.code != "" { return Theme.pending; }
        if p.paired && p.linked { return Theme.connected; }
        return Theme.offline;
    }

    // Charge colours, as the phone's rings: green, then yellow, then red.
    public pure function battery-color(p: Phone) -> color {
        if p.charging || p.battery > 20 { return Theme.connected; }
        if p.battery > 10 { return Theme.pending; }
        return Theme.error;
    }

    public pure function signal-color(level: int) -> color {
        if level >= 3 { return Theme.connected; }
        if level == 2 { return Theme.pending; }
        return Theme.error;
    }
}

component Glyph inherits Image {
    in property <color> tint;
    colorize: tint;
    width: 18px;
    height: 18px;
}

// A filled squircle with a white glyph and a specular edge, as the phone's list rows.
component Badge inherits Rectangle {
    in property <image> icon;
    in property <color> fill;
    in property <length> size: 32px;
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: fill;
    border-width: 1px;
    border-color: @linear-gradient(Theme.rim-angle, #FFFFFFB0 0%, #FFFFFF24 35%, #FFFFFF24 65%, #FFFFFF8A 100%);
    Glyph {
        source: root.icon;
        tint: white;
        width: root.size * 0.56;
        height: root.size * 0.56;
    }
}

// The page's hero glyph: the phone's device glyph, a solid object in the accent that catches the light.
component HeroGlyph inherits Rectangle {
    in property <image> icon;
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background: Theme.accent-fill;
    border-width: 1px;
    border-color: @linear-gradient(Theme.rim-angle, #FFFFFFC0 0%, #FFFFFF26 35%, #FFFFFF26 65%, #FFFFFF90 100%);
    drop-shadow-blur: 22px;
    drop-shadow-offset-x: Theme.fall-x * 8px;
    drop-shadow-offset-y: Theme.fall-y * 8px;
    drop-shadow-color: Theme.accent-fill.transparentize(Theme.dark ? 60% : 55%);
    Glyph {
        source: root.icon;
        tint: white;
        width: 34px;
        height: 34px;
    }
}

// A sheet of glass: translucent, its edge lit facing the light, its shadow (light theme) away from
// it. Its content is a column.
component Glass inherits Rectangle {
    in property <length> radius: 26px;
    border-radius: radius;
    background: Theme.card;
    drop-shadow-blur: Theme.dark ? 0px : 14px;
    drop-shadow-offset-x: Theme.fall-x * 4.8px;
    drop-shadow-offset-y: Theme.fall-y * 4.8px;
    drop-shadow-color: Theme.dark ? transparent : #1A2B4C0D;
    VerticalLayout {
        @children
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.rim;
    }
}

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 13px;
    font-weight: 500;
}

// A labelled group: the muted label over its glass card, as the phone's sections.
component Section inherits VerticalLayout {
    in property <string> label;
    spacing: 8px;
    padding-top: 12px;
    SectionLabel {
        text: root.label;
        x: 18px;
    }
    Glass {
        @children
    }
}

// The phone's pill. Prominent is the deep accent under white words, else a tint of it. It dips
// while pressed and springs back.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> prominent;
    in property <bool> destructive;
    in property <bool> enabled: true;
    // The one way forward at the end of a flow: taller, larger words.
    in property <bool> large;
    callback clicked;
    // Its own width in a row; a column still stretches it (the large one at the end of a flow).
    horizontal-stretch: 0;
    height: large ? 50px : 36px;
    min-width: max(large ? 160px : 88px, label.preferred-width + 40px);
    property <length> dip: touch.pressed && root.enabled ? 2px : 0px;
    animate dip { duration: 160ms; easing: ease-out-back; }
    face := Rectangle {
        x: root.dip;
        y: root.dip;
        width: root.width - 2 * root.dip;
        height: root.height - 2 * root.dip;
        border-radius: self.height / 2;
        opacity: root.enabled ? 1 : 0.4;
        background: root.prominent
            ? (touch.pressed ? Theme.accent-fill.darker(0.12) : touch.has-hover ? Theme.accent-fill.brighter(0.08) : Theme.accent-fill)
            : (root.destructive ? Theme.error : Theme.accent).with-alpha(touch.pressed ? 0.24 : touch.has-hover ? 0.18 : 0.12);
        animate background { duration: 140ms; }
        border-width: root.prominent ? 1px : 0px;
        border-color: @linear-gradient(Theme.rim-angle, #FFFFFF59 0%, #FFFFFF14 40%, #FFFFFF14 60%, #FFFFFF40 100%);
        label := Text {
            text: root.text;
            color: root.prominent ? white : root.destructive ? Theme.error : Theme.accent;
            font-size: root.large ? 16px : 14px;
            font-weight: 600;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The phone's switch, as iOS's: one eased progress moves the knob and blends the track into the
// accent together, so they never disagree; held, the knob stretches towards the middle.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 50px;
    height: 30px;
    border-radius: self.height / 2;
    property <float> t: root.on ? 1 : 0;
    animate t { duration: 300ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
    property <length> stretch: touch.pressed ? 6px : 0px;
    animate stretch { duration: 200ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
    background: Theme.accent-fill.mix(Theme.track, root.t);
    property <length> knob: 26px;
    Rectangle {
        width: root.knob + root.stretch;
        height: root.knob;
        x: 2px + (root.width - 4px - root.knob - root.stretch) * root.t;
        y: 2px;
        border-radius: self.height / 2;
        background: white;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000033;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// The phone's row: a badge, title over subtitle, then a value, a small action, or a switch (the
// whole row toggles it). The hover keeps the card's round where the row meets its corners.
component Row inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color;
    in property <bool> has-icon: true;
    in property <string> title;
    in property <color> title-color: Theme.text;
    in property <string> subtitle;
    in property <string> value;
    in property <color> value-color: Theme.muted;
    in property <string> action;
    in property <bool> switch;
    in property <bool> on;
    in property <bool> tappable: switch;
    in property <bool> first;
    in property <bool> last;
    callback clicked;
    callback act;
    border-top-left-radius: first ? 26px : 0px;
    border-top-right-radius: first ? 26px : 0px;
    border-bottom-left-radius: last ? 26px : 0px;
    border-bottom-right-radius: last ? 26px : 0px;
    background: tappable && touch.pressed ? Theme.pressed : tappable && touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    touch := TouchArea {
        enabled: root.tappable;
        mouse-cursor: root.tappable ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: root.subtitle == "" ? 12px : 13px;
        padding-bottom: root.subtitle == "" ? 12px : 13px;
        spacing: 14px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Badge {
                icon: root.icon;
                fill: root.icon-color;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if root.value != "": Text {
            text: root.value;
            color: root.value-color;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            PillButton {
                text: root.action;
                prominent: true;
                clicked => { root.act(); }
            }
        }
        if root.switch: VerticalLayout {
            alignment: center;
            Switch {
                on: root.on;
                toggled => { root.clicked(); }
            }
        }
    }
    Rectangle {
        x: root.has-icon ? 64px : 18px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.divider;
        visible: !root.last;
    }
}

// A status row: a dot in its colour, the name, what it means.
component StatusRow inherits Rectangle {
    in property <color> dot;
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <color> value-color: Theme.muted;
    in property <bool> last;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        VerticalLayout {
            alignment: start;
            padding-top: 6px;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.dot;
            }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if root.value != "": Text {
            text: root.value;
            color: root.value-color;
            font-size: 14px;
        }
    }
    Rectangle {
        x: 41px;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Theme.divider;
        visible: !root.last;
    }
}

// An action, as the phone's Shortcuts tiles: a filled tile, its glyph top left, its name bottom
// left. It dips while pressed (every edge 3 px in, the phone's PressAuto) and springs back.
component Tile inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> fill;
    in property <bool> enabled: true;
    callback clicked;
    height: 100px;
    property <length> dip: touch.pressed && root.enabled ? 3px : 0px;
    animate dip { duration: 180ms; easing: ease-out-back; }
    Rectangle {
        x: root.dip;
        y: root.dip;
        width: root.width - 2 * root.dip;
        height: root.height - 2 * root.dip;
        border-radius: 18px;
        opacity: root.enabled ? 1 : 0.38;
        background: root.enabled && touch.has-hover && !touch.pressed ? root.fill.brighter(0.1) : root.fill;
        animate background { duration: 140ms; }
        border-width: 1px;
        border-color: @linear-gradient(Theme.rim-angle, #FFFFFF66 0%, #FFFFFF14 35%, #FFFFFF14 65%, #FFFFFF4D 100%);
        drop-shadow-blur: Theme.dark ? 0px : 16px;
        drop-shadow-offset-x: Theme.fall-x * 5px;
        drop-shadow-offset-y: Theme.fall-y * 5px;
        drop-shadow-color: Theme.dark ? transparent : root.fill.transparentize(72%);
        Glyph {
            x: 16px;
            y: 16px;
            width: 24px;
            height: 24px;
            source: root.icon;
            tint: white;
        }
        Text {
            x: 16px;
            y: parent.height - self.height - 14px;
            width: parent.width - 32px;
            text: root.text;
            color: white;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The battery as the phone's hero ring: a 270° gauge that eases to each new charge.
component Ring inherits Rectangle {
    in property <float> value;
    in property <color> tone;
    in property <string> reading;
    width: 88px;
    height: 88px;
    property <float> shown: root.value;
    animate shown { duration: 900ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <float> r: 38;
    property <float> c: 44;
    property <angle> end: 135deg + 270deg * max(0.001, min(1, root.shown));
    Path {
        width: 88px;
        height: 88px;
        viewbox-width: 88;
        viewbox-height: 88;
        stroke: Theme.track;
        stroke-width: 7px;
        stroke-line-cap: round;
        MoveTo {
            x: root.c + root.r * cos(135deg);
            y: root.c + root.r * sin(135deg);
        }
        ArcTo {
            x: root.c + root.r * cos(45deg);
            y: root.c + root.r * sin(45deg);
            radius-x: root.r;
            radius-y: root.r;
            large-arc: true;
            sweep: true;
        }
    }
    if root.shown > 0.004: Path {
        width: 88px;
        height: 88px;
        viewbox-width: 88;
        viewbox-height: 88;
        stroke: root.tone;
        stroke-width: 7px;
        stroke-line-cap: round;
        MoveTo {
            x: root.c + root.r * cos(135deg);
            y: root.c + root.r * sin(135deg);
        }
        ArcTo {
            x: root.c + root.r * cos(root.end);
            y: root.c + root.r * sin(root.end);
            radius-x: root.r;
            radius-y: root.r;
            large-arc: root.shown > 2 / 3;
            sweep: true;
        }
    }
    Text {
        text: root.reading;
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A meter: name and reading over a 6 px capsule bar that eases to each new value.
component Meter inherits VerticalLayout {
    in property <string> label;
    in property <string> reading;
    in property <float> value;
    in property <color> tone;
    property <float> shown: root.value;
    animate shown { duration: 700ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    spacing: 8px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            horizontal-stretch: 1;
        }
        Text {
            text: root.reading;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
        }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.shown));
            border-radius: 3px;
            background: root.tone;
        }
    }
}

// A card that asks one thing: a title, a line, then its buttons, centred.
component AskCard inherits Glass {
    in property <string> title;
    in property <string> body;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 17px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            color: Theme.muted;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        @children
    }
}

// A cue: a sentence that saves the question, after a small yellow bulb (the phone's Tip).
component Tip inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Glyph {
            source: @image-url("icons/bulb.svg");
            tint: Theme.dark ? #FFD60A : #E0A800;
            width: 16px;
            height: 16px;
        }
    }
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// A glass capsule floating at the top of a page (the phone's header bubbles).
component Capsule inherits Rectangle {
    in property <string> text;
    in property <bool> tappable;
    callback clicked;
    height: 40px;
    width: words.preferred-width + 36px;
    border-radius: 20px;
    background: tappable && touch.pressed ? Theme.popup : Theme.chrome;
    border-width: 1px;
    border-color: Theme.rim;
    drop-shadow-blur: Theme.dark ? 0px : 14px;
    drop-shadow-offset-x: Theme.fall-x * 4px;
    drop-shadow-offset-y: Theme.fall-y * 4px;
    drop-shadow-color: Theme.shadow;
    words := Text {
        text: root.text;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
    }
    touch := TouchArea {
        enabled: root.tappable;
        mouse-cursor: root.tappable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A page: the phone's hero (glyph, title, a line) in the top of the page, then the content in a
// column of at most 620 px. It rises in when it opens. Scrolled past the hero, the title rides in a
// glass bubble at the top. [action]: a glass capsule at the top right.
component Page inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> subtitle-color: Theme.muted;
    in property <image> glyph;
    in property <bool> has-glyph: true;
    in property <string> action;
    callback act();
    property <length> column: min(620px, root.width - 64px);
    property <length> hero: max(200px, min(290px, root.height * 0.34));
    property <bool> entered;
    init => { root.entered = true; }
    scroll := ScrollView {
        width: root.width;
        height: root.height;
        y: root.entered ? 0px : 16px;
        opacity: root.entered ? 1 : 0;
        animate y { duration: 520ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        animate opacity { duration: 300ms; easing: ease-out; }
        VerticalLayout {
            padding-left: (root.width - root.column) / 2;
            padding-right: (root.width - root.column) / 2;
            padding-bottom: 48px;
            spacing: 14px;
            alignment: start;
            VerticalLayout {
                height: root.hero;
                alignment: end;
                padding-bottom: 26px;
                spacing: 6px;
                if root.has-glyph: HorizontalLayout {
                    alignment: center;
                    padding-bottom: 10px;
                    HeroGlyph {
                        icon: root.glyph;
                    }
                }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 38px;
                    font-weight: 700;
                    letter-spacing: -1px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: root.subtitle-color;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
            }
            @children
        }
    }
    // Past the hero, the title docks in a bubble at the top.
    property <bool> docked: -scroll.content-y > root.hero - 64px;
    Capsule {
        text: root.title;
        x: (root.width - self.width) / 2;
        y: root.docked ? 16px : 2px;
        opacity: root.docked ? 1 : 0;
        visible: self.opacity > 0.01;
        animate y { duration: 360ms; easing: ease-out-back; }
        animate opacity { duration: 200ms; }
    }
    if root.action != "": Capsule {
        text: root.action;
        tappable: true;
        x: root.width - self.width - 20px;
        y: 16px;
        clicked => { root.act(); }
    }
}

// An item in the sidebar: a coloured squircle (with a status dot) and a name over a line. The
// chosen one sits on the neutral capsule, its name in the accent.
component SideItem inherits Rectangle {
    in property <image> icon;
    in property <color> fill;
    in property <string> title;
    in property <string> subtitle;
    in property <color> subtitle-color: Theme.muted;
    in property <color> dot: transparent;
    in property <bool> selected;
    callback clicked;
    height: 50px;
    border-radius: 15px;
    background: selected ? Theme.selection : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 180ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                Badge {
                    icon: root.icon;
                    fill: root.fill;
                    size: 30px;
                }
                if root.dot != transparent: Rectangle {
                    x: parent.width - 9px;
                    y: parent.height - 9px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.dot;
                    border-width: 2px;
                    border-color: Theme.dark ? #26272B : #F1F2F5;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                color: root.selected ? Theme.accent : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                animate color { duration: 180ms; }
            }
            Text {
                text: root.subtitle;
                color: root.subtitle-color;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PhonePage inherits Page {
    in property <Phone> phone;
    in-out property <bool> confirm-unpair;
    callback pair(string);
    callback accept(string);
    callback reject(string);
    callback ring(string);
    callback browse(string);
    callback send-files(string);
    callback set-permission(string, string, bool);
    callback allow-clipboard(string);
    title: phone.name;
    subtitle: Words.headline(phone);
    glyph: @image-url("icons/phone.svg");

    // A pairing on screen: the code to compare.
    if root.phone.code != "": AskCard {
        title: root.phone.asking ? "Pair with " + root.phone.name + "?" : "Accept on the phone";
        body: root.phone.asking
            ? "Make sure this code matches the one on your phone, then accept."
            : "Accept on your phone if it shows this same code.";
        Text {
            text: root.phone.code;
            color: Theme.text;
            font-size: 36px;
            font-weight: 600;
            letter-spacing: 6px;
            horizontal-alignment: center;
        }
        if root.phone.asking: HorizontalLayout {
            alignment: center;
            spacing: 10px;
            padding-top: 4px;
            PillButton {
                text: "Reject";
                clicked => { root.reject(root.phone.id); }
            }
            PillButton {
                text: "Accept";
                prominent: true;
                clicked => { root.accept(root.phone.id); }
            }
        }
    }

    // Nearby but not paired.
    if !root.phone.paired && root.phone.code == "": AskCard {
        title: "Pair with this phone";
        body: root.phone.linked
            ? "You'll compare a code on both screens. Once paired, it connects by itself."
            : "It's not nearby right now. Open Vyoma on the phone, on the same network as this PC.";
        HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            PillButton {
                text: "Pair";
                prominent: true;
                enabled: root.phone.linked;
                clicked => { root.pair(root.phone.id); }
            }
        }
    }

    // Glanceable state first: the battery ring and the signal, as the phone's status card.
    if root.phone.paired: Glass {
        opacity: root.phone.linked ? 1 : 0.6;
        animate opacity { duration: 300ms; }
        HorizontalLayout {
            padding: 20px;
            padding-left: 24px;
            padding-right: 26px;
            spacing: 28px;
            alignment: root.phone.sims.length > 0 ? stretch : center;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Ring {
                    value: root.phone.linked && root.phone.battery >= 0 ? root.phone.battery / 100 : 0;
                    tone: Words.battery-color(root.phone);
                    reading: root.phone.linked && root.phone.battery >= 0 ? root.phone.battery + "%" : "—";
                }
                Text {
                    text: !root.phone.linked ? "Away" : root.phone.charging ? "Charging" : "Battery";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
            if root.phone.sims.length > 0: VerticalLayout {
                alignment: center;
                spacing: 18px;
                horizontal-stretch: 1;
                for s in root.phone.sims: Meter {
                    label: s.label;
                    reading: s.network;
                    value: root.phone.linked ? s.level / 4 : 0;
                    tone: Words.signal-color(s.level);
                }
            }
        }
    }

    // One-shot actions as the phone's tiles, floating on the canvas.
    if root.phone.paired: HorizontalLayout {
        spacing: 12px;
        Tile {
            icon: @image-url("icons/send.svg");
            text: "Send files";
            fill: Theme.tile-blue;
            enabled: root.phone.linked && root.phone.can-share;
            clicked => { root.send-files(root.phone.id); }
        }
        Tile {
            icon: @image-url("icons/folder.svg");
            text: "Phone files";
            fill: Theme.tile-teal;
            enabled: root.phone.linked && root.phone.can-browse;
            clicked => { root.browse(root.phone.id); }
        }
        Tile {
            icon: @image-url("icons/bell.svg");
            text: "Ring";
            fill: Theme.tile-orange;
            enabled: root.phone.linked && root.phone.can-ring;
            clicked => { root.ring(root.phone.id); }
        }
    }
    if root.phone.paired && root.phone.via == "bluetooth": Text {
        text: "Files need Wi-Fi or the USB cable.";
        color: Theme.muted;
        font-size: 13px;
        horizontal-alignment: center;
    }

    // Copying on the phone with Vyoma closed: Android lets only the app in front read the
    // clipboard, and a computer can lift that once, over the cable.
    if root.phone.paired: Section {
        label: "Clipboard";
        Row {
            icon: @image-url("icons/clipboard.svg");
            icon-color: Theme.orange;
            title: "Sync when Vyoma's closed";
            subtitle: root.phone.clip == "on" ? "Anything you copy on the phone reaches this PC, even with Vyoma closed."
                : root.phone.clip == "ask" ? "Your phone's plugged in. Allow this once and it stays until you uninstall."
                : "Plug the phone in once with a USB cable, with USB debugging on, then allow it here.";
            value: root.phone.clip == "on" ? "On" : "";
            value-color: Theme.connected;
            action: root.phone.clip == "ask" ? "Allow" : "";
            first: true;
            last: true;
            act => { root.allow-clipboard(root.phone.id); }
        }
    }

    // What it may do here; off stops it at once.
    if root.phone.paired && root.phone.permits.length > 0: Section {
        label: "Allow this phone to";
        for p[i] in root.phone.permits: Row {
            icon: p.key == "screen" ? @image-url("icons/computer.svg")
                : p.key == "control" ? @image-url("icons/pointer.svg")
                : p.key == "files" ? @image-url("icons/folder.svg")
                : p.key == "camera" ? @image-url("icons/camera.svg")
                : p.key == "webcam" ? @image-url("icons/video.svg")
                : @image-url("icons/power.svg");
            icon-color: p.key == "screen" ? Theme.red
                : p.key == "control" ? Theme.teal
                : p.key == "files" ? Theme.blue
                : p.key == "camera" ? Theme.orange
                : p.key == "webcam" ? Theme.green
                : Theme.gray;
            title: p.name;
            subtitle: p.detail;
            switch: true;
            on: p.on;
            first: i == 0;
            last: i == root.phone.permits.length - 1;
            clicked => { root.set-permission(root.phone.id, p.key, !p.on); }
        }
    }

    // Unpair asks in a dialog.
    if root.phone.paired: VerticalLayout {
        padding-top: 12px;
        Glass {
            Row {
                has-icon: false;
                title: "Unpair";
                title-color: Theme.error;
                tappable: true;
                first: true;
                last: true;
                clicked => { root.confirm-unpair = true; }
            }
        }
    }
}

component PcPage inherits Page {
    in property <[Feature]> features;
    in property <[Check]> checks;
    in property <[string]> notes;
    in property <bool> installable;
    in property <bool> installing;
    in property <int> attention;
    in property <bool> loaded;
    callback install();
    callback setup();
    title: "This PC";
    glyph: @image-url("icons/computer.svg");
    subtitle: !loaded ? "Checking…" : attention == 0 ? "Ready for everything" : attention == 1 ? "1 thing to set up" : attention + " things to set up";
    subtitle-color: loaded && attention > 0 ? Theme.pending : Theme.muted;

    if root.installable: AskCard {
        title: "Install what's missing";
        body: "Adds what the features below need. Your password is asked for once.";
        HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            PillButton {
                text: root.installing ? "Installing…" : "Install";
                prominent: true;
                enabled: !root.installing;
                clicked => { root.install(); }
            }
        }
    }

    if root.checks.length > 0: Glass {
        for c[i] in root.checks: StatusRow {
            dot: c.state == "ok" ? Theme.connected : c.state == "warn" ? Theme.pending : Theme.offline;
            title: c.name;
            subtitle: c.detail;
            last: i == root.checks.length - 1;
        }
    }

    if root.features.length > 0: Section {
        label: "Features";
        for f[i] in root.features: StatusRow {
            dot: f.ready ? Theme.connected : Theme.pending;
            title: f.name;
            value: f.detail;
            value-color: f.ready ? Theme.muted : Theme.pending;
            last: i == root.features.length - 1;
        }
    }

    if root.notes.length > 0: Section {
        label: "Worth knowing";
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            for n in root.notes: Tip {
                text: n;
            }
        }
    }

    VerticalLayout {
        padding-top: 12px;
        Glass {
            Row {
                has-icon: false;
                title: "Run setup again";
                title-color: Theme.accent;
                tappable: true;
                first: true;
                last: true;
                clicked => { root.setup(); }
            }
        }
    }
}

// One thing in the activity: its badge (the colour of the switch that allows it), what happened,
// which phone and when.
component HappeningRow inherits Row {
    in property <Happening> item;
    pure function pick-icon(kind: string) -> image {
        if kind == "screenshot" || kind == "screen" { return @image-url("icons/computer.svg"); }
        if kind == "photo" { return @image-url("icons/camera.svg"); }
        if kind == "files" { return @image-url("icons/folder.svg"); }
        if kind == "share" { return @image-url("icons/send.svg"); }
        if kind == "power" { return @image-url("icons/power.svg"); }
        if kind == "webcam" { return @image-url("icons/video.svg"); }
        if kind == "control" { return @image-url("icons/gamepad.svg"); }
        if kind == "touchpad" { return @image-url("icons/pointer.svg"); }
        if kind == "refused" { return @image-url("icons/blocked.svg"); }
        return @image-url("icons/terminal.svg");
    }
    pure function pick-color(kind: string) -> color {
        if kind == "screenshot" || kind == "screen" { return Theme.red; }
        if kind == "control" || kind == "touchpad" { return Theme.teal; }
        if kind == "files" || kind == "share" { return Theme.blue; }
        if kind == "photo" { return Theme.orange; }
        if kind == "webcam" { return Theme.green; }
        return Theme.gray;
    }
    icon: pick-icon(item.kind);
    icon-color: pick-color(item.kind);
    title: item.text;
    subtitle: item.meta;
}

component ActivityPage inherits Page {
    in property <[Day]> days;
    in property <bool> loaded;
    in-out property <bool> confirm-clear;
    title: "Activity";
    glyph: @image-url("icons/clock.svg");
    subtitle: "What your phones did on this PC";
    action: days.length > 0 ? "Clear" : "";
    act => { root.confirm-clear = true; }

    if root.loaded && root.days.length == 0: Text {
        text: "Nothing yet. When a phone takes a screenshot or a photo, moves files, or puts this PC to sleep, it shows up here.";
        color: Theme.muted;
        font-size: 15px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    for d in root.days: Section {
        label: d.label;
        for e[i] in d.items: HappeningRow {
            item: e;
            first: i == 0;
            last: i == d.items.length - 1;
        }
    }
}

// A text field on glass: the label above, a placeholder while empty, the accent ring while typing.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> mono;
    in-out property <string> text;
    callback accepted;
    public function take-focus() { input.focus(); }
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 13px;
        font-weight: 500;
    }
    Rectangle {
        height: 42px;
        border-radius: 12px;
        background: Theme.raised;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.divider;
        animate border-color { duration: 160ms; }
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }
        if root.text == "": Text {
            x: 14px;
            width: parent.width - 28px;
            text: root.placeholder;
            color: Theme.muted.transparentize(35%);
            font-size: 14px;
            font-family: root.mono ? "monospace" : "Inter";
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text <=> root.text;
            color: Theme.text;
            font-size: 14px;
            font-family: root.mono ? "monospace" : "Inter";
            single-line: true;
            vertical-alignment: center;
            selection-background-color: Theme.accent.with-alpha(0.3);
            accepted => { root.accepted(); }
        }
    }
}

// The commands phones can run here, as kdeconnectd's: each opens in the editor; ready-made ones
// below to start from.
component CommandsPage inherits Page {
    in property <[Command]> commands;
    in property <[Command]> suggestions;
    callback edit(Command);
    callback add();
    title: "Commands";
    glyph: @image-url("icons/terminal.svg");
    subtitle: "What your phones can run on this PC";
    action: "Add";
    act => { root.add(); }

    if root.commands.length == 0: Text {
        text: "None yet. Add one here, or start from a suggestion: it shows on your phones under Commands, ready to run.";
        color: Theme.muted;
        font-size: 15px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    if root.commands.length > 0: Section {
        label: "On your phones";
        for c[i] in root.commands: Row {
            icon: @image-url("icons/terminal.svg");
            icon-color: Theme.green;
            title: c.name;
            subtitle: c.command;
            value: c.fingerprint ? "Fingerprint" : "";
            tappable: true;
            first: i == 0;
            last: i == root.commands.length - 1;
            clicked => { root.edit(c); }
        }
    }

    VerticalLayout {
        padding-top: root.commands.length > 0 ? 0px : 4px;
        Glass {
            Row {
                icon: @image-url("icons/plus.svg");
                icon-color: Theme.accent-fill;
                title: "Add a command";
                title-color: Theme.accent;
                tappable: true;
                first: true;
                last: true;
                clicked => { root.add(); }
            }
        }
    }

    if root.suggestions.length > 0: Section {
        label: "Suggestions";
        for c[i] in root.suggestions: Row {
            icon: @image-url("icons/terminal.svg");
            icon-color: Theme.gray;
            title: c.name;
            subtitle: c.command;
            action: "Add";
            first: i == 0;
            last: i == root.suggestions.length - 1;
            act => { root.edit(c); }
        }
    }

    VerticalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        spacing: 10px;
        Tip {
            text: "A command runs as you, in a shell, the moment a phone asks. Add only what you'd let your phone do here.";
        }
        Tip {
            text: "Ask for fingerprint has Vyoma on the phone check it's you before running it, for the ones that matter, like shutting down.";
        }
    }
}

// The command editor: name, command line, whether the phone asks for a fingerprint first. A glass
// sheet that settles in; Escape cancels, Return saves.
component CommandSheet inherits Rectangle {
    in property <bool> shown;
    // Empty for a new command.
    in property <string> key;
    in-out property <string> name;
    in-out property <string> command;
    in-out property <bool> fingerprint;
    callback saved();
    callback removed();
    callback cancelled();
    property <bool> ready: root.name != "" && root.command != "";
    changed shown => {
        if root.shown { name-field.take-focus(); }
    }
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 180ms; }
    background: #00000059;
    TouchArea {
        clicked => { root.cancelled(); }
    }
    property <length> full: min(480px, root.width - 48px);
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return EventResult.accept; }
            if event.text == Key.Return && root.ready { root.saved(); return EventResult.accept; }
            EventResult.reject
        }
        Rectangle {
            width: root.shown ? root.full : root.full * 0.92;
            height: box.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            animate width { duration: 320ms; easing: ease-out-back; }
            border-radius: 28px;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.rim;
            drop-shadow-blur: 32px;
            drop-shadow-offset-x: Theme.fall-x * 12px;
            drop-shadow-offset-y: Theme.fall-y * 12px;
            drop-shadow-color: #00000040;
            TouchArea { }
            box := VerticalLayout {
                padding: 26px;
                padding-bottom: 22px;
                spacing: 16px;
                Text {
                    text: root.key == "" ? "New command" : "Edit command";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                }
                name-field := Field {
                    label: "Name on the phone";
                    placeholder: "Lock the screen";
                    text <=> root.name;
                    accepted => { command-field.take-focus(); }
                }
                command-field := Field {
                    label: "Command";
                    placeholder: "loginctl lock-session";
                    mono: true;
                    text <=> root.command;
                    accepted => {
                        if root.ready { root.saved(); }
                    }
                }
                Rectangle {
                    border-radius: 16px;
                    background: Theme.raised;
                    HorizontalLayout {
                        padding: 14px;
                        padding-left: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Badge {
                                icon: @image-url("icons/fingerprint.svg");
                                fill: Theme.red;
                                size: 30px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Ask for fingerprint first";
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 500;
                            }
                            Text {
                                text: "Vyoma on the phone checks it's you before running it";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: root.fingerprint;
                                toggled => { root.fingerprint = !root.fingerprint; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    if root.key != "": PillButton {
                        text: "Delete";
                        destructive: true;
                        clicked => { root.removed(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        text: "Cancel";
                        clicked => { root.cancelled(); }
                    }
                    PillButton {
                        text: "Save";
                        prominent: true;
                        enabled: root.ready;
                        clicked => { root.saved(); }
                    }
                }
            }
        }
    }
}

// No phone to show: the daemon's down, or nothing's paired or nearby yet.
component EmptyPage inherits Page {
    in property <bool> daemon-ok;
    callback search();
    title: daemon-ok ? "No phones yet" : "Vyoma isn't running";
    glyph: @image-url("icons/phone.svg");
    Text {
        text: root.daemon-ok
            ? "Open Vyoma on your phone, on the same network as this PC. It shows up here."
            : "The background service that talks to your phones has stopped. It starts again with your session.";
        color: Theme.muted;
        font-size: 15px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    if root.daemon-ok: HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        PillButton {
            text: "Search for phones";
            prominent: true;
            clicked => { root.search(); }
        }
    }
}

// A step of setup, as the phone's: its number (a tick once done), what it is and where it stands;
// its content unfolds while it's the open one.
component SetupCard inherits Glass {
    in property <int> number;
    in property <string> title;
    in property <string> status;
    in property <bool> done;
    in property <bool> open;
    callback clicked;
    Rectangle {
        height: 74px;
        border-top-left-radius: 26px;
        border-top-right-radius: 26px;
        border-bottom-left-radius: root.open ? 0px : 26px;
        border-bottom-right-radius: root.open ? 0px : 26px;
        background: head.pressed && !root.open ? Theme.pressed : head.has-hover && !root.open ? Theme.hover : transparent;
        animate background { duration: 120ms; }
        head := TouchArea {
            enabled: !root.open;
            mouse-cursor: root.open ? default : pointer;
            clicked => { root.clicked(); }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.done ? Theme.green : root.open ? Theme.accent-fill : Theme.track;
                    animate background { duration: 240ms; }
                    if root.done: Glyph {
                        source: @image-url("icons/check.svg");
                        tint: white;
                    }
                    if !root.done: Text {
                        text: root.number;
                        color: root.open ? white : Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.status;
                    color: root.done ? Theme.connected : Theme.muted;
                    font-size: 13px;
                }
            }
        }
    }
    Rectangle {
        height: root.open ? body.preferred-height : 0px;
        clip: true;
        animate height { duration: 380ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        body := VerticalLayout {
            y: 0;
            opacity: root.open ? 1 : 0;
            animate opacity { duration: 260ms; }
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            spacing: 12px;
            @children
        }
    }
}

// A phone in setup's pairing step: what it is, then its state or the way to pair it.
component SetupPhone inherits HorizontalLayout {
    in property <Phone> phone;
    callback pair(string);
    spacing: 14px;
    VerticalLayout {
        alignment: center;
        Badge {
            icon: @image-url("icons/phone.svg");
            fill: Theme.blue;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.phone.name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 500;
        }
        Text {
            text: root.phone.paired ? "Paired" : root.phone.code != "" ? "Pairing…" : "Nearby";
            color: root.phone.paired ? Theme.connected : Theme.muted;
            font-size: 13px;
        }
    }
    if root.phone.paired: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Theme.green;
            Glyph {
                source: @image-url("icons/check.svg");
                tint: white;
                width: 16px;
                height: 16px;
            }
        }
    }
    if !root.phone.paired && root.phone.code == "": VerticalLayout {
        alignment: center;
        PillButton {
            text: "Pair";
            prominent: true;
            clicked => { root.pair(root.phone.id); }
        }
    }
}

// First run, as the phone's: one step at a time on the wallpaper, each saying why it asks and
// closing into a tick when done. Only pairing matters to use it; the rest is on This PC later.
component SetupPage inherits Page {
    in property <[Phone]> phones;
    in property <[Phone]> nearby;
    in property <bool> daemon-ok;
    in property <[Feature]> missing;
    in property <bool> installable;
    in property <bool> installing;
    in property <bool> health-loaded;
    callback pair(string);
    callback accept(string);
    callback reject(string);
    callback search();
    callback install();
    callback finish();
    property <bool> paired: root.phones.length > 0;
    // The first thing left to do is the open one; a click can open another.
    property <int> current: !root.paired ? 0 : root.installable ? 1 : 2;
    property <int> chosen: -1;
    property <int> open: root.chosen >= 0 ? root.chosen : root.current;
    changed current => { root.chosen = -1; }
    title: "Let's set up";
    glyph: @image-url("icons/computer.svg");
    subtitle: root.current == 0 ? "Pair your phone with this PC. It takes a minute."
        : root.current == 1 ? "Paired. A few things make this PC ready for everything."
        : "Nearly there";

    SetupCard {
        number: 1;
        title: "Pair with your phone";
        status: root.paired ? root.phones[0].name : "Both need to agree once";
        done: root.paired;
        open: root.open == 0;
        clicked => { root.chosen = 0; }
        if !root.daemon-ok: Tip {
            text: "Vyoma's background service isn't running. It starts with your session; log out and back in, or restart it.";
        }
        for p in root.phones: SetupPhone {
            phone: p;
        }
        for p in root.nearby: VerticalLayout {
            spacing: 12px;
            SetupPhone {
                phone: p;
                pair(id) => { root.pair(id); }
            }
            // The code to compare, right under the phone it's for.
            if p.code != "": Rectangle {
                border-radius: 18px;
                background: Theme.raised;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: p.asking ? "Make sure this code matches the one on your phone, then accept." : "Accept on your phone if it shows this same code.";
                        color: Theme.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: p.code;
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 600;
                        letter-spacing: 5px;
                        horizontal-alignment: center;
                    }
                    if p.asking: HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        PillButton {
                            text: "Reject";
                            clicked => { root.reject(p.id); }
                        }
                        PillButton {
                            text: "Accept";
                            prominent: true;
                            clicked => { root.accept(p.id); }
                        }
                    }
                }
            }
        }
        if root.daemon-ok && root.phones.length == 0 && root.nearby.length == 0: VerticalLayout {
            spacing: 12px;
            Text {
                text: "Looking for your phone…";
                color: Theme.text;
                font-size: 15px;
            }
            Tip {
                text: "Open Vyoma on your phone, on the same Wi-Fi as this PC, or plug it in with a USB cable. Don't have it yet? It's at github.com/Prajwaljb/VyomaConnect.";
            }
            HorizontalLayout {
                alignment: start;
                PillButton {
                    text: "Search for phones";
                    clicked => { root.search(); }
                }
            }
        }
        if !root.paired && root.nearby.length > 0: Tip {
            text: "You'll check that a code matches on both screens: that's how you know it's your phone.";
        }
    }

    SetupCard {
        number: 2;
        title: "Get this PC ready";
        status: !root.health-loaded ? "Checking…" : root.installable ? "Some features need a little more" : "Ready for everything";
        done: root.health-loaded && !root.installable;
        open: root.open == 1;
        clicked => { root.chosen = 1; }
        if root.missing.length > 0: VerticalLayout {
            spacing: 8px;
            for f in root.missing: HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.pending;
                    }
                }
                Text {
                    text: f.name;
                    color: Theme.text;
                    font-size: 14px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: f.detail;
                    color: Theme.muted;
                    font-size: 13px;
                }
            }
        }
        if root.installable: Tip {
            text: "One install adds what these need. Your password is asked for once.";
        }
        if root.installable: HorizontalLayout {
            alignment: start;
            PillButton {
                text: root.installing ? "Installing…" : "Install";
                prominent: true;
                enabled: !root.installing;
                clicked => { root.install(); }
            }
        }
        if !root.installable: Tip {
            text: "Everything your phone can do here is ready. This PC's page shows it any time.";
        }
    }

    SetupCard {
        number: 3;
        title: "Good to know";
        status: "Then you're done";
        done: false;
        open: root.open == 2;
        clicked => { root.chosen = 2; }
        Tip {
            text: "Your phone connects by itself whenever it's near. This window can be closed: Vyoma keeps running.";
        }
        Tip {
            text: "Choose what each phone may do here on its page, under Allow this phone to.";
        }
        Tip {
            text: "For copying on the phone with Vyoma closed, plug it in once and click Allow on its page.";
        }
    }

    HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        PillButton {
            min-width: 260px;
            text: root.paired ? "Start using Vyoma" : "Skip for now";
            prominent: true;
            large: true;
            clicked => { root.finish(); }
        }
    }
}

// The moment a phone pairs: a drop of glass with a tick swells in, then who it is.
component PairedMoment inherits Rectangle {
    in property <bool> shown;
    in property <string> name;
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 240ms; }
    background: Theme.canvas.transparentize(Theme.dark ? 6% : 8%);
    TouchArea { }
    VerticalLayout {
        alignment: center;
        spacing: 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 150px;
                height: 150px;
                Rectangle {
                    property <length> d: root.shown ? 150px : 40px;
                    animate d { duration: 700ms; easing: ease-out-back; }
                    x: (150px - self.d) / 2;
                    y: (150px - self.d) / 2;
                    width: self.d;
                    height: self.d;
                    border-radius: self.d / 2;
                    background: Theme.green;
                    border-width: 1px;
                    border-color: @linear-gradient(Theme.rim-angle, #FFFFFFBF 0%, #FFFFFF24 35%, #FFFFFF24 65%, #FFFFFF99 100%);
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-x: Theme.fall-x * 8px;
                    drop-shadow-offset-y: Theme.fall-y * 8px;
                    drop-shadow-color: #16A34A55;
                    Glyph {
                        source: @image-url("icons/check.svg");
                        tint: white;
                        width: parent.width * 0.43;
                        height: parent.height * 0.43;
                    }
                }
            }
        }
        Rectangle {
            height: words.preferred-height;
            words := VerticalLayout {
            spacing: 4px;
            y: root.shown ? 0px : 18px;
            animate y { duration: 520ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
            Text {
                text: "You're connected";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.name;
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }
        }
        }
    }
}

// A glass dialog over a dimmed window, as the phone's: title, a line, then Cancel and the action.
// It settles in from a little smaller; Escape cancels, Return confirms.
component Dialog inherits Rectangle {
    in property <bool> shown;
    in property <string> title;
    in property <string> body;
    in property <string> confirm;
    callback confirmed();
    callback cancelled();
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 180ms; }
    background: #00000059;
    TouchArea {
        clicked => { root.cancelled(); }
    }
    property <length> full: min(400px, root.width - 48px);
    card := Rectangle {
        width: root.shown ? root.full : root.full * 0.92;
        height: box.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        animate width { duration: 320ms; easing: ease-out-back; }
        border-radius: 28px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.rim;
        drop-shadow-blur: 32px;
        drop-shadow-offset-x: Theme.fall-x * 12px;
        drop-shadow-offset-y: Theme.fall-y * 12px;
        drop-shadow-color: #00000040;
        // Swallows clicks so they don't reach the scrim.
        TouchArea { }
        box := VerticalLayout {
            padding: 26px;
            padding-bottom: 20px;
            spacing: 10px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 10px;
                PillButton {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
                PillButton {
                    text: root.confirm;
                    destructive: true;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Vyoma";
    preferred-width: 1040px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 540px;
    default-font-family: "Inter";
    background: Theme.canvas;
    forward-focus: keys;

    in property <[Phone]> phones;
    in property <[Phone]> nearby;
    in property <Phone> current;
    in property <bool> has-current;
    in property <bool> daemon-ok: true;
    // This PC's page (selected: "this-pc").
    in property <[Feature]> features;
    in property <[Check]> checks;
    in property <[string]> notes;
    in property <bool> installable;
    in property <bool> installing;
    in property <int> attention;
    in property <bool> health-loaded;
    // The activity (selected: "activity").
    in property <[Day]> days;
    in property <bool> activity-loaded;
    in property <string> activity-summary: "Nothing yet";
    // Commands phones can run (selected: "commands"), and ready-made ones not added yet.
    in property <[Command]> commands;
    in property <[Command]> suggestions;
    // The command editor: open while [editing], on [edit-key] ("" for a new one).
    in-out property <bool> editing;
    in-out property <string> edit-key;
    in-out property <string> edit-name;
    in-out property <string> edit-command;
    in-out property <bool> edit-fingerprint;
    // A short outcome, in the glass bubble at the top while [notice-on] (the words stay while it leaves).
    in property <string> notice;
    in property <bool> notice-on;
    in-out property <string> selected;
    in-out property <bool> confirm-unpair;
    in-out property <bool> confirm-clear;
    // First run: the setup steps over the whole window, until finished or skipped.
    in-out property <bool> setup;
    in property <[Feature]> missing;
    // A phone just paired during setup: [moment] is its name, shown while [moment-on].
    in property <string> moment;
    in-out property <bool> moment-on;

    callback select(string);
    // Up (-1) or Down (+1) through the sidebar.
    callback step(int);
    callback search();
    callback pair(string);
    callback accept(string);
    callback reject(string);
    callback unpair(string);
    callback ring(string);
    callback browse(string);
    callback send-files(string);
    callback set-permission(string, string, bool);
    callback allow-clipboard(string);
    callback show-pc();
    callback show-activity();
    callback show-commands();
    // key ("" for new), name, command line, fingerprint.
    callback save-command(string, string, string, bool);
    callback remove-command(string);
    callback clear-activity();
    callback install();
    callback finish-setup();

    property <length> side: 268px;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirm-unpair { root.confirm-unpair = false; return EventResult.accept; }
                if root.confirm-clear { root.confirm-clear = false; return EventResult.accept; }
                if root.moment-on { root.moment-on = false; return EventResult.accept; }
                return EventResult.reject;
            }
            if event.text == Key.Return {
                if root.confirm-unpair { root.confirm-unpair = false; root.unpair(root.current.id); return EventResult.accept; }
                if root.confirm-clear { root.confirm-clear = false; root.clear-activity(); return EventResult.accept; }
                return EventResult.reject;
            }
            if root.setup || root.confirm-unpair || root.confirm-clear || root.editing { return EventResult.reject; }
            if event.text == Key.UpArrow { root.step(-1); return EventResult.accept; }
            if event.text == Key.DownArrow { root.step(1); return EventResult.accept; }
            EventResult.reject
        }
    }

    // The canvas: the wallpaper's colours, soft, fading into plain canvas towards the bottom; else
    // the accent's glow from the top centre.
    if Theme.has-wall: Image {
        width: parent.width;
        height: parent.height;
        source: Theme.wall;
        image-fit: fill;
        image-rendering: smooth;
    }
    if Theme.has-wall: Rectangle {
        background: @linear-gradient(180deg, Theme.canvas.transparentize(100%) 35%, Theme.canvas.transparentize(Theme.dark ? 15% : 30%) 100%);
    }
    if !Theme.has-wall: Rectangle {
        property <length> r: max(root.width, root.height) * 0.75;
        x: (root.width - self.width) / 2;
        y: -self.r;
        width: self.r * 2;
        height: self.r * 2;
        background: @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.2) 0%, Theme.accent.with-alpha(Theme.dark ? 0.056 : 0.07) 50%, Theme.accent.transparentize(100%) 100%);
    }

    // The sidebar: floating glass, as the phone's tab bar.
    if !root.setup: Rectangle {
        x: 12px;
        y: 12px;
        width: root.side;
        height: parent.height - 24px;
        border-radius: 26px;
        background: Theme.chrome;
        drop-shadow-blur: Theme.dark ? 0px : 20px;
        drop-shadow-offset-x: Theme.fall-x * 6px;
        drop-shadow-offset-y: Theme.fall-y * 6px;
        drop-shadow-color: Theme.shadow;
        Rectangle {
            border-radius: 26px;
            border-width: 1px;
            border-color: Theme.rim;
        }
        VerticalLayout {
            padding: 10px;
            padding-top: 22px;
            spacing: 2px;
            Text {
                text: "Vyoma";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: -0.5px;
                x: 12px;
            }
            Rectangle { height: 12px; }
            if root.phones.length > 0: SectionLabel {
                text: "Phones";
                height: 26px;
                x: 12px;
                vertical-alignment: center;
            }
            for p in root.phones: SideItem {
                icon: @image-url("icons/phone.svg");
                fill: Theme.blue;
                title: p.name;
                subtitle: Words.short(p);
                subtitle-color: p.code != "" ? Theme.pending : Theme.muted;
                dot: Words.dot(p);
                selected: p.id == root.selected;
                clicked => { root.select(p.id); }
            }
            if root.nearby.length > 0: SectionLabel {
                text: "Nearby";
                height: 34px;
                x: 12px;
                vertical-alignment: bottom;
            }
            for p in root.nearby: SideItem {
                icon: @image-url("icons/phone.svg");
                fill: Theme.gray;
                title: p.name;
                subtitle: Words.short(p);
                subtitle-color: p.code != "" ? Theme.pending : Theme.muted;
                dot: Words.dot(p);
                selected: p.id == root.selected;
                clicked => { root.select(p.id); }
            }
            Rectangle {
                vertical-stretch: 1;
            }
            if root.daemon-ok: SideItem {
                icon: @image-url("icons/computer.svg");
                fill: Theme.gray;
                title: "This PC";
                subtitle: !root.health-loaded || root.attention == 0 ? "Ready" : root.attention == 1 ? "1 thing to set up" : root.attention + " things to set up";
                subtitle-color: root.health-loaded && root.attention > 0 ? Theme.pending : Theme.muted;
                dot: root.health-loaded && root.attention > 0 ? Theme.pending : transparent;
                selected: root.selected == "this-pc";
                clicked => { root.show-pc(); }
            }
            if root.daemon-ok: SideItem {
                icon: @image-url("icons/clock.svg");
                fill: Theme.orange;
                title: "Activity";
                subtitle: root.activity-summary;
                selected: root.selected == "activity";
                clicked => { root.show-activity(); }
            }
            if root.daemon-ok: SideItem {
                icon: @image-url("icons/terminal.svg");
                fill: Theme.green;
                title: "Commands";
                subtitle: root.commands.length == 0 ? "None yet" : root.commands.length == 1 ? "1 command" : root.commands.length + " commands";
                selected: root.selected == "commands";
                clicked => { root.show-commands(); }
            }
            // Asks phones nearby to show themselves again.
            if root.daemon-ok: Rectangle {
                height: 40px;
                border-radius: 14px;
                background: search-touch.pressed ? Theme.pressed : search-touch.has-hover ? Theme.hover : transparent;
                animate background { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 17px;
                    spacing: 15px;
                    VerticalLayout {
                        alignment: center;
                        Glyph {
                            source: @image-url("icons/refresh.svg");
                            tint: Theme.muted;
                            width: 16px;
                            height: 16px;
                        }
                    }
                    Text {
                        text: "Search for phones";
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                search-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.search(); }
                }
            }
        }
    }

    // The chosen page; each rises in as it opens.
    if !root.setup: Rectangle {
        x: root.side + 12px;
        width: parent.width - self.x;
        height: parent.height;
        if root.selected == "this-pc" && root.daemon-ok: PcPage {
            features: root.features;
            checks: root.checks;
            notes: root.notes;
            installable: root.installable;
            installing: root.installing;
            attention: root.attention;
            loaded: root.health-loaded;
            install => { root.install(); }
            setup => { root.setup = true; }
        }
        if root.selected == "activity" && root.daemon-ok: ActivityPage {
            days: root.days;
            loaded: root.activity-loaded;
            confirm-clear <=> root.confirm-clear;
        }
        if root.selected == "commands" && root.daemon-ok: CommandsPage {
            commands: root.commands;
            suggestions: root.suggestions;
            add => {
                root.edit-key = "";
                root.edit-name = "";
                root.edit-command = "";
                root.edit-fingerprint = false;
                root.editing = true;
            }
            edit(c) => {
                root.edit-key = c.key;
                root.edit-name = c.name;
                root.edit-command = c.command;
                root.edit-fingerprint = c.fingerprint;
                root.editing = true;
            }
        }
        if root.selected != "this-pc" && root.selected != "activity" && root.selected != "commands" && root.has-current: PhonePage {
            phone: root.current;
            confirm-unpair <=> root.confirm-unpair;
            pair(id) => { root.pair(id); }
            accept(id) => { root.accept(id); }
            reject(id) => { root.reject(id); }
            ring(id) => { root.ring(id); }
            browse(id) => { root.browse(id); }
            send-files(id) => { root.send-files(id); }
            set-permission(id, key, on) => { root.set-permission(id, key, on); }
            allow-clipboard(id) => { root.allow-clipboard(id); }
        }
        if ((root.selected != "this-pc" && root.selected != "activity" && root.selected != "commands") || !root.daemon-ok) && !root.has-current: EmptyPage {
            daemon-ok: root.daemon-ok;
            search => { root.search(); }
        }
    }

    if root.setup: SetupPage {
        width: root.width;
        height: root.height;
        phones: root.phones;
        nearby: root.nearby;
        daemon-ok: root.daemon-ok;
        missing: root.missing;
        installable: root.installable;
        installing: root.installing;
        health-loaded: root.health-loaded;
        pair(id) => { root.pair(id); }
        accept(id) => { root.accept(id); }
        reject(id) => { root.reject(id); }
        search => { root.search(); }
        install => { root.install(); }
        finish => { root.finish-setup(); }
    }
    PairedMoment {
        shown: root.moment-on;
        name: root.moment;
    }

    // The status bubble: glass that drops from the top with the outcome, as the phone's.
    Rectangle {
        property <length> area-x: root.setup ? 0px : root.side + 12px;
        width: min(notice-text.preferred-width + 44px, root.width - self.area-x - 160px);
        height: max(44px, notice-text.preferred-height + 22px);
        x: self.area-x + (root.width - self.area-x - self.width) / 2;
        y: root.notice-on ? 18px : -self.height - 30px;
        animate y { duration: 420ms; easing: ease-out-back; }
        border-radius: 22px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.rim;
        drop-shadow-blur: 22px;
        drop-shadow-offset-x: Theme.fall-x * 8px;
        drop-shadow-offset-y: Theme.fall-y * 8px;
        drop-shadow-color: Theme.dark ? #00000080 : #1A2B4C26;
        notice-text := Text {
            width: parent.width - 44px;
            text: root.notice;
            color: Theme.text;
            font-size: 14px;
            font-weight: 500;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    CommandSheet {
        shown: root.editing;
        key: root.edit-key;
        name <=> root.edit-name;
        command <=> root.edit-command;
        fingerprint <=> root.edit-fingerprint;
        cancelled => {
            root.editing = false;
            keys.focus();
        }
        saved => {
            root.editing = false;
            keys.focus();
            root.save-command(root.edit-key, root.edit-name, root.edit-command, root.edit-fingerprint);
        }
        removed => {
            root.editing = false;
            keys.focus();
            root.remove-command(root.edit-key);
        }
    }
    Dialog {
        shown: root.confirm-unpair;
        title: "Unpair " + root.current.name + "?";
        body: "You'll need to pair again to use it here.";
        confirm: "Unpair";
        cancelled => { root.confirm-unpair = false; }
        confirmed => {
            root.confirm-unpair = false;
            root.unpair(root.current.id);
        }
    }
    Dialog {
        shown: root.confirm-clear;
        title: "Clear the activity?";
        body: "Everything your phones did here is forgotten. It can't be brought back.";
        confirm: "Clear";
        cancelled => { root.confirm-clear = false; }
        confirmed => {
            root.confirm-clear = false;
            root.clear-activity();
        }
    }
}
