<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug only: hosts our widgets at One UI cell sizes for layout checks. -->
        <activity
            android:name=".debug.WidgetLabActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!--
          Next to the release app, the debug build's widgets would show up twice in the launcher's
          widget picker. Keep them off; WidgetLabActivity enables them only while it runs.
        -->
        <receiver android:name="dev.vyoma.connect.widget.StatusWidgetReceiver" android:enabled="false" tools:node="merge" />
        <receiver android:name="dev.vyoma.connect.widget.ActionsWidgetReceiver" android:enabled="false" tools:node="merge" />
        <receiver android:name="dev.vyoma.connect.widget.MediaWidgetReceiver" android:enabled="false" tools:node="merge" />
        <receiver android:name="dev.vyoma.connect.widget.ClipboardWidgetReceiver" android:enabled="false" tools:node="merge" />
        <receiver android:name="dev.vyoma.connect.widget.DropWidgetReceiver" android:enabled="false" tools:node="merge" />
    </application>
</manifest>
