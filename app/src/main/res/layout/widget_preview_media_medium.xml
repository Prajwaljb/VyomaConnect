<?xml version="1.0" encoding="utf-8"?>
<!-- Generated widget-picker preview (One UI medium slot). Static sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="125dp" android:layout_height="130dp"
    android:background="@drawable/widget_preview_bg" android:orientation="vertical" android:gravity="top" android:padding="10dp">
<ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_preview_art" android:padding="12dp" android:src="@drawable/ic_w_music" android:tint="@android:color/white" />
<FrameLayout android:layout_width="1dp" android:layout_height="6dp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Song title" android:textColor="@color/widget_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artist" android:textColor="@color/widget_ink_soft" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_preview_button" android:padding="8dp" android:src="@drawable/ic_skip_previous" android:tint="@color/widget_ink" />
<FrameLayout android:layout_width="4dp" android:layout_height="1dp" />
<ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_accent_button" android:padding="9dp" android:src="@drawable/ic_pause" android:tint="@android:color/white" />
<FrameLayout android:layout_width="4dp" android:layout_height="1dp" />
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_preview_button" android:padding="8dp" android:src="@drawable/ic_skip_next" android:tint="@color/widget_ink" />
</LinearLayout>
</LinearLayout>
