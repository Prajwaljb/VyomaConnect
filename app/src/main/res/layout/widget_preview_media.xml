<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-drawer preview. Static, so it uses sample content; the real widget is drawn by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/widget_preview_art" android:padding="18dp" android:src="@drawable/ic_w_music" android:tint="@android:color/white" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Song title" android:textColor="@color/widget_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artist · on My PC" android:textColor="@color/widget_ink_soft" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/widget_preview_button" android:padding="10dp" android:src="@drawable/ic_skip_previous" android:tint="@color/widget_ink" />
        <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_preview_accent_button" android:padding="12dp" android:src="@drawable/ic_pause" android:tint="@android:color/white" />
        <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/widget_preview_button" android:padding="10dp" android:src="@drawable/ic_skip_next" android:tint="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
