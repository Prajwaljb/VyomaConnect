<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-drawer preview. Static, so it uses sample content; the real widget is drawn by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:gravity="center_vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_preview_button" android:padding="12dp" android:src="@drawable/ic_w_clipboard" android:tint="@color/widget_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Clipboard" android:textColor="@color/widget_ink_soft" android:textSize="11sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_preview_button" android:padding="12dp" android:src="@drawable/ic_w_upload" android:tint="@color/widget_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Files" android:textColor="@color/widget_ink_soft" android:textSize="11sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_preview_button" android:padding="12dp" android:src="@drawable/ic_w_mouse" android:tint="@color/widget_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Touchpad" android:textColor="@color/widget_ink_soft" android:textSize="11sp" />
        </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_preview_accent_button" android:padding="12dp" android:src="@drawable/ic_play" android:tint="@android:color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Play" android:textColor="@color/widget_ink_soft" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
