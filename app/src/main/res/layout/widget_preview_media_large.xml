<?xml version="1.0" encoding="utf-8"?>
<!-- Generated widget-picker preview (One UI large slot). Static sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="270dp" android:layout_height="130dp"
    android:background="@drawable/widget_preview_bg" android:orientation="vertical" android:gravity="top" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/widget_preview_art" android:padding="16dp" android:src="@drawable/ic_w_music" android:tint="@android:color/white" />
<FrameLayout android:layout_width="12dp" android:layout_height="1dp" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Song title" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artist · on My PC" android:textColor="@color/widget_ink_soft" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
<ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_button" android:padding="9dp" android:src="@drawable/ic_skip_previous" android:tint="@color/widget_ink" />
<FrameLayout android:layout_width="10dp" android:layout_height="1dp" />
<ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/widget_preview_accent_button" android:padding="11dp" android:src="@drawable/ic_pause" android:tint="@android:color/white" />
<FrameLayout android:layout_width="10dp" android:layout_height="1dp" />
<ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_preview_button" android:padding="9dp" android:src="@drawable/ic_skip_next" android:tint="@color/widget_ink" />
</LinearLayout>
</LinearLayout>
