<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Home: blur style and one picker preview per size (see values/attrs.xml). -->
<samsung-appwidget-info xmlns:app="http://schemas.android.com/apk/res-auto"
    app:widgetStyle="colorful"
    app:widgetSize="tiny|small|wideSmall|medium|large"
    app:previewSize="tiny|small|wideSmall|medium|large"
    app:targetHost="home"
    app:previewLayoutTiny="@layout/widget_preview_status_tiny"
    app:previewLayoutSmall="@layout/widget_preview_status_small"
    app:previewLayoutWideSmall="@layout/widget_preview_status_wide_small"
    app:previewLayoutMedium="@layout/widget_preview_status_medium"
    app:previewLayoutLarge="@layout/widget_preview_status_large" />
