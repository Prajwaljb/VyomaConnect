<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <gradient android:angle="315" android:startColor="@android:color/system_accent1_500" android:endColor="@android:color/system_accent3_400" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
