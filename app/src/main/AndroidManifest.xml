<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17+: reaching devices on the LAN is a runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Calls & messages on the PC (KDE Connect SMS app, call alerts, contacts sync) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Find my phone rings over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Android 16+: transfer progress as a Live Update (One UI Now Bar). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Optional background clipboard sync; both only via a one-time ADB grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />

    <!-- SMS/phone permissions imply telephony; keep Wi-Fi-only tablets installable. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".VyomaApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vyoma"
        tools:targetApi="37">
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.ClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma.Invisible" />

        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FindMyPhoneActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".platform.VyomaNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.CommandReceiver"
            android:exported="false" />

        <!-- Quick Settings tiles -->
        <service android:name=".widget.ClipboardTile" android:exported="true" android:icon="@drawable/ic_w_clipboard" android:label="Send clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.MediaTile" android:exported="true" android:icon="@drawable/ic_play" android:label="PC media"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.TouchpadTile" android:exported="true" android:icon="@drawable/ic_w_mouse" android:label="Touchpad"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.LockPcTile" android:exported="true" android:icon="@drawable/ic_w_lock" android:label="Lock PC"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- Home screen widgets -->
        <receiver android:name=".widget.StatusWidgetReceiver" android:exported="true" android:label="@string/widget_status">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_status" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_status_colorful" />
        </receiver>
        <receiver android:name=".widget.ActionsWidgetReceiver" android:exported="true" android:label="@string/widget_actions">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_actions" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_actions_colorful" />
            <!-- One UI reads this for the widget's long-press "Settings". -->
            <meta-data android:name="android.appwidget.provider.semConfigureActivity" android:value="dev.vyoma.connect.ui.QuickActionsSettingsActivity" />
        </receiver>
        <activity
            android:name=".ui.QuickActionsSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.MediaWidgetReceiver" android:exported="true" android:label="@string/widget_media">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_media" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_media_colorful" />
        </receiver>
        <receiver android:name=".widget.ClipboardWidgetReceiver" android:exported="true" android:label="@string/widget_clipboard">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clipboard" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_clipboard_colorful" />
        </receiver>
        <receiver android:name=".widget.DropWidgetReceiver" android:exported="true" android:label="@string/widget_drop">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_drop" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_drop_colorful" />
        </receiver>

        <service
            android:name=".service.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.PairActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
