<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The live PC screen holds a low-latency Wi-Fi lock while it's open. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17+: reaching devices on the LAN is a runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The phone as the PC's webcam and microphone (PhoneWebcam), only while the user streams. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The fallback link to a PC when Wi-Fi and the cable aren't there (off until the user turns it on). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Rules that run at a set time (the user allows it in system settings). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Calls & messages on the PC (KDE Connect SMS app, call alerts, contacts sync) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Find my phone rings over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Android 16+: transfer progress as a Live Update (One UI Now Bar). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Optional background clipboard sync; both only via a one-time ADB grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />

    <!-- SMS/phone permissions imply telephony; keep Wi-Fi-only tablets installable. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Lists apps with a launcher icon (Settings › Notifications: per-app choices). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VyomaApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vyoma"
        tools:targetApi="37">
        <profileable android:shell="true" tools:targetApi="29" />

        <!-- Portrait only: a phone remote has no use for landscape; the PC screen viewer is the exception. -->
        <activity
            android:name=".ui.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.ClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma.Invisible" />

        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PcScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.MirrorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Lets the PC's mouse and keyboard work the mirrored screen (switched on by the user). -->
        <service
            android:name=".mirror.MirrorAccessibility"
            android:exported="true"
            android:label="@string/mirror_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/mirror_control" />
        </service>

        <activity
            android:name=".ui.WebcamActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.GamepadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape" />

        <!-- The PC companion's USB accessory (the game controller over a cable without USB debugging):
             Android opens this for it, it hands the accessory over and closes. -->
        <activity
            android:name=".gamepad.AccessoryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Vyoma.Invisible">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <activity
            android:name=".ui.FindMyPhoneActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".platform.VyomaNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.CommandReceiver"
            android:exported="false" />

        <!-- Automation rules: a scheduled time, or exact timing just allowed. -->
        <receiver
            android:name=".automation.RuleAlarmReceiver"
            android:exported="false">
            <intent-filter><action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" /></intent-filter>
        </receiver>

        <!-- Quick Settings tiles -->
        <service android:name=".widget.ClipboardTile" android:exported="true" android:icon="@drawable/ic_w_clipboard" android:label="Send clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.MediaTile" android:exported="true" android:icon="@drawable/ic_play" android:label="PC media"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.TouchpadTile" android:exported="true" android:icon="@drawable/ic_w_mouse" android:label="Touchpad"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.LockPcTile" android:exported="true" android:icon="@drawable/ic_w_lock" android:label="Lock PC"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- Home screen widgets -->
        <receiver android:name=".widget.StatusWidgetReceiver" android:exported="true" android:label="@string/widget_status">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_status" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_status_colorful" />
        </receiver>
        <receiver android:name=".widget.ActionsWidgetReceiver" android:exported="true" android:label="@string/widget_actions">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_actions" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_actions_colorful" />
            <!-- One UI reads this for the widget's long-press "Settings". -->
            <meta-data android:name="android.appwidget.provider.semConfigureActivity" android:value="dev.vyoma.connect.ui.QuickActionsSettingsActivity" />
        </receiver>
        <activity
            android:name=".ui.QuickActionsSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vyoma">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.MediaWidgetReceiver" android:exported="true" android:label="@string/widget_media">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_media" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_media_colorful" />
        </receiver>
        <receiver android:name=".widget.ClipboardWidgetReceiver" android:exported="true" android:label="@string/widget_clipboard">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clipboard" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_clipboard_colorful" />
        </receiver>
        <receiver android:name=".widget.DropWidgetReceiver" android:exported="true" android:label="@string/widget_drop">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_drop" />
            <meta-data android:name="samsung.appwidget.colorful.info" android:resource="@xml/widget_drop_colorful" />
        </receiver>

        <service
            android:name=".service.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|microphone|mediaProjection" />

        <receiver
            android:name=".service.PairActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.OutdoorReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Lends PC files opened only to look at to the viewer app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
