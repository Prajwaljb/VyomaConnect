pkgbase = vyoma
	pkgdesc = Your Android phone and your Linux PC, working as one: files, clipboard, calls, screens and remote control (KDE Connect protocol)
	pkgver = 0.9.0
	pkgrel = 1
	url = https://github.com/Prajwaljb/VyomaConnect
	install = vyoma.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = pkgconf
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = purpose
	depends = glib2
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-base-libs
	depends = gst-plugins-bad
	depends = gst-plugin-pipewire
	depends = gst-plugin-va
	depends = gst-libav
	depends = fontconfig
	depends = freetype2
	depends = libxkbcommon
	depends = wayland
	depends = libglvnd
	depends = libx11
	depends = libxcb
	depends = pipewire
	depends = wireplumber
	depends = libpulse
	depends = wl-clipboard
	depends = libnotify
	depends = xdg-utils
	depends = android-tools
	depends = ffmpeg
	depends = sshfs
	depends = gvfs
	depends = curl
	optdepends = purpose: Send to your phone from KDE's Share menu
	optdepends = v4l2loopback-dkms: the phone as a webcam (CachyOS kernels already have it)
	optdepends = thunar: Send to your phone from Thunar
	optdepends = python-nautilus: Send to your phone from GNOME Files
	optdepends = ddcutil: brightness of external monitors on GNOME
	optdepends = firewalld: opened for phones automatically when it runs
	options = !lto
	source = vyoma-0.9.0.tar.gz::https://github.com/Prajwaljb/VyomaConnect/archive/refs/tags/v0.9.0.tar.gz
